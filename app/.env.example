# Copier en .env puis adapter.

# --- Base PostgreSQL ---
DB_NAME=analyseur
DB_USER=analyseur
DB_PASSWORD=analyseur
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=change-moi
DJANGO_DEBUG=1
# Noms d'hôte acceptés (séparés par des virgules)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Réseaux autorisés à accéder à l'app (vide = tout le monde)
ALLOWED_NETS=127.0.0.0/8,::1/128

# --- Horodatage ---
# Fuseau des dates "naïves" écrites dans les logs du banc
LOG_TIMEZONE=Europe/Paris

# --- Chemins ---
PROTOCOLS_DIR=../protocols
INGEST_CONFIG=../config/ingest.yaml
